cmake_minimum_required(VERSION 3.31)

include("${CMAKE_CURRENT_LIST_DIR}/parse-exports.cmake")
file(READ "${EXPORTS_FILE}" exports)
cork_parse_dumpbin_exports(actual "${exports}")
file(STRINGS "${DEFINITION}" expected REGEX "^[ \t]+[?]")
list(TRANSFORM expected STRIP)
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Parsed exports differ: expected ${expected}, got ${actual}")
endif()
list(LENGTH actual export_count)
if(NOT export_count EQUAL 7)
    message(FATAL_ERROR "Expected seven parsed exports, got ${export_count}")
endif()
message(STATUS "Parsed ${export_count} Cork API exports from dumpbin output")
