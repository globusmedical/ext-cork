cmake_minimum_required(VERSION 3.31)

function(dumpbin output)
    execute_process(COMMAND "${DUMPBIN}" ${ARGN}
        OUTPUT_VARIABLE text ERROR_VARIABLE errors RESULT_VARIABLE result
    )
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "dumpbin failed: ${errors}\n${text}")
    endif()
    set(${output} "${text}" PARENT_SCOPE)
endfunction()

dumpbin(exports /exports "${PREFIX}/bin/${CONFIG}/cork.dll")
file(WRITE "${LOG_DIR}/exports.txt" "${exports}")
include("${CMAKE_CURRENT_LIST_DIR}/parse-exports.cmake")
cork_parse_dumpbin_exports(actual "${exports}")
file(STRINGS "${DEFINITION}" expected REGEX "^[ \t]+[?]")
list(TRANSFORM expected STRIP)
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Exports differ: expected ${expected}, got ${actual}")
endif()

execute_process(COMMAND "${LIB_TOOL}" /nologo /list "${PREFIX}/lib/${CONFIG}/cork.lib"
    OUTPUT_VARIABLE members ERROR_VARIABLE errors RESULT_VARIABLE result
)
file(WRITE "${LOG_DIR}/import-library.txt" "${members}\n${errors}")
string(REPLACE "\r" "" members "${members}")
string(STRIP "${members}" members)
string(REPLACE "\n" ";" members "${members}")
if(NOT result EQUAL 0 OR NOT members)
    message(FATAL_ERROR "Cannot inspect Cork's import library: ${errors}")
endif()
foreach(member IN LISTS members)
    string(STRIP "${member}" member)
    if(NOT member STREQUAL "cork.dll")
        message(FATAL_ERROR "Unexpected implementation member in import library: ${member}")
    endif()
endforeach()

dumpbin(imports /imports "${PREFIX}/bin/${CONFIG}/cork.dll")
file(WRITE "${LOG_DIR}/imports.txt" "${imports}")
if(NOT imports MATCHES "mpir[.]dll")
    message(FATAL_ERROR "The Cork DLL is not dynamically linked to mpir.dll")
endif()
file(GLOB_RECURSE packaged_mpir "${PREFIX}/*mpir*" "${PREFIX}/*gmp*")
if(packaged_mpir)
    message(FATAL_ERROR "MPIR must not be packaged: ${packaged_mpir}")
endif()
message(STATUS "Seven API exports, true import library, dynamic MPIR, no packaged MPIR")
