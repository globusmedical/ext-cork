function(cork_parse_dumpbin_exports output dumpbin_output)
    string(REPLACE "\r\n" "\n" normalized "${dumpbin_output}")
    string(REPLACE "\n" ";" lines "${normalized}")
    set(names)
    foreach(line IN LISTS lines)
        if(line MATCHES "^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+[0-9A-Fa-f]+[ \t]+([?][^ =\t]+)")
            list(APPEND names "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    set(${output} "${names}" PARENT_SCOPE)
endfunction()
