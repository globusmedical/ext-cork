find_path(MPIR_INCLUDE_DIR NAMES mpir.h)
get_filename_component(mpir_prefix "${MPIR_INCLUDE_DIR}" DIRECTORY)
find_path(MPIR_CXX_INCLUDE_DIR NAMES mpirxx.h
    PATHS "${MPIR_INCLUDE_DIR}" NO_DEFAULT_PATH
)
find_library(MPIR_LIBRARY_RELEASE NAMES mpir PATHS "${mpir_prefix}/lib" NO_DEFAULT_PATH)
find_library(MPIR_LIBRARY_DEBUG NAMES mpir PATHS "${mpir_prefix}/debug/lib" NO_DEFAULT_PATH)
find_file(MPIR_RUNTIME_RELEASE NAMES mpir.dll PATHS "${mpir_prefix}/bin" NO_DEFAULT_PATH)
find_file(MPIR_RUNTIME_DEBUG NAMES mpir.dll PATHS "${mpir_prefix}/debug/bin" NO_DEFAULT_PATH)

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(MPIR REQUIRED_VARS
    MPIR_INCLUDE_DIR MPIR_CXX_INCLUDE_DIR
    MPIR_LIBRARY_RELEASE MPIR_LIBRARY_DEBUG MPIR_RUNTIME_RELEASE MPIR_RUNTIME_DEBUG
)
if(MPIR_FOUND AND NOT TARGET MPIR::mpir)
    add_library(MPIR::mpir SHARED IMPORTED)
    set_target_properties(MPIR::mpir PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${MPIR_INCLUDE_DIR}"
        IMPORTED_CONFIGURATIONS "Debug;Release"
        IMPORTED_IMPLIB_DEBUG "${MPIR_LIBRARY_DEBUG}"
        IMPORTED_IMPLIB_RELEASE "${MPIR_LIBRARY_RELEASE}"
        IMPORTED_LOCATION_DEBUG "${MPIR_RUNTIME_DEBUG}"
        IMPORTED_LOCATION_RELEASE "${MPIR_RUNTIME_RELEASE}"
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
        MAP_IMPORTED_CONFIG_MINSIZEREL Release
    )
endif()
mark_as_advanced(MPIR_INCLUDE_DIR MPIR_CXX_INCLUDE_DIR
    MPIR_LIBRARY_RELEASE MPIR_LIBRARY_DEBUG MPIR_RUNTIME_RELEASE MPIR_RUNTIME_DEBUG
)
